# Copy to .env before running. Values below are for local development only.
# Production must replace every secret and set APP_ENV=production.

# ---------- app ----------
APP_ENV=development
APP_NAME=Golden Base
APP_PORT=8000
APP_TIMEZONE=Asia/Shanghai
# comma separated origins; leave empty in local dev to allow same-origin only
CORS_ORIGINS=http://localhost:8080
# behind the bundled nginx this stays true; direct exposure must keep it false
TRUST_PROXY_HEADERS=true

# ---------- secrets (REPLACE) ----------
JWT_SECRET_KEY=dev-only-jwt-secret-please-replace-0123456789abcdef
ADMIN_TOKEN=dev-admin-token-replace-me
SENSITIVE_FIELD_KEY=dev-only-sensitive-field-key-0123456789

# ---------- database ----------
# DB_PASSWORD 同时用于「应用连库」与「MySQL 容器的 MYSQL_PASSWORD」，
# 不要在 .env 里再写一份 MYSQL_PASSWORD（compose 会忽略）。
# 生产启动自检会按值拦下下面三个 dev-* 示例口令。
DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=app_db
DB_USER=app
DB_PASSWORD=dev-db-password-change-me
MYSQL_ROOT_PASSWORD=dev-root-password-change-me

# ---------- redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dev-redis-password-change-me

# ---------- payment ----------
# Demo only: lets /api/order/create and /api/payment/mock/pay complete without a real channel.
# Startup refuses this when APP_ENV=production.
PAYMENT_MOCK=true
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_NOTIFY_URL=
ALIPAY_APP_ID=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# ---------- compliance decisions ----------
# Three statutory controls are OFF in this skeleton by default: the payment disclaimer
# server-side check (ENFORCE_PAYMENT_DISCLAIMER), personal-income-tax withholding on
# commission withdrawals (WITHDRAW_TAX_ENABLED), and the age gate (minor_guard, closed by
# the owner decision recorded on 2026-09-11).
# In production the startup check refuses to boot until you confirm you reviewed each of
# them for THIS deployment; after the ack they stay in the log as ERROR on every start.
# Do not set this true just to get a boot: read docs/deploy.md first, then decide whether
# any of the three should actually be turned on. Ignored outside APP_ENV=production.
COMPLIANCE_DECISIONS_ACK=false

# ---------- nginx ----------
HTTP_PORT=8080
# keep identical to backend PROXY_AUTH_SECRET; leave empty to skip the header check
PROXY_AUTH_SECRET=
